# Copy to .env. docker-compose reads it automatically; .env is gitignored, so the key
# never lands in a commit.

# The key we provide. A live run needs it; the tests do not.
ANTHROPIC_API_KEY=

# The model the agent runs on. Any id the provider accepts; haiku is what we ship because
# it is cheap and fast enough for this loop.
ANTHROPIC_MODEL=claude-haiku-4-5

# DEBUG to see every request the api handles.
LOG_LEVEL=INFO
